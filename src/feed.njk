---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self" />
  <link href="{{ site.url }}/" />
  <updated>{{ collections.posts[0].date | isoDate }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author.name }}</name></author>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl(site.url) }}" />
    <updated>{{ post.date | isoDate }}</updated>
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    {% if post.data.description %}<summary>{{ post.data.description }}</summary>{% endif %}
  </entry>
  {%- endfor %}
</feed>
