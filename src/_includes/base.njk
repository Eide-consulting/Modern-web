<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {% set pageTitle = title or site.title %}
    {% set fullTitle = title and (title + " – " + site.title) or site.title %}
    {% set desc = description or site.description %}
    {% set canonical = (page.url | absoluteUrl(site.url)) %}
    {% set ogImg = (image or site.ogImage) | absoluteUrl(site.url) %}

    <title>{{ fullTitle }}</title>
    <meta name="description" content="{{ desc }}" />
    <link rel="canonical" href="{{ canonical }}" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />

    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ desc }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ ogImg }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ desc }}" />
    <meta name="twitter:image" content="{{ ogImg }}" />

    <link rel="stylesheet" href="/assets/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">{{ site.title }}</a>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/about-me/">About</a>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {{ site.title }} · {{ site.author.name }} · <a href="{{ site.author.linkedin }}">LinkedIn</a> · <a href="/feed.xml">RSS</a></p>
      </div>
    </footer>
  </body>
</html>
